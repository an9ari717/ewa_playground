generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  role     Role    @default(EMPLOYEE)
  isActive Boolean @default(true)

  // --- Auth fields ---
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?

  // Department relation (user belongs to one department)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals   Approval[]        @relation("ApproverApprovals")
  requests    Request[]         @relation("RequesterRequests")
  assignments RequestAssignee[] @relation("UserAssignments")

  @@index([role])
  @@index([isActive])
  @@index([departmentId])
}

model RequestType {
  id   String @id @default(cuid())
  key  String @unique
  name String

  // NEW: short uppercase code like "IT", "HR", "FIN" (optional for safe backfill; we’ll enforce NOT NULL later)
  code String? @unique

  // NEW: link each request type to a department (optional for now, we’ll tighten later)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  steps     ApprovalStep[]
  requests  Request[]      @relation("TypeRequests")

  @@index([departmentId])
}

model Request {
  id          String        @id @default(cuid())
  typeId      String
  title       String
  payload     Json
  status      RequestStatus @default(PENDING)
  requesterId String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // NEW: human-friendly code shown in UI (e.g., IT-25-0007). Optional for safe backfill; we’ll enforce NOT NULL later.
  publicCode String? @unique

  approvals Approval[]
  history   HistoryEntry[]
  requester User        @relation("RequesterRequests", fields: [requesterId], references: [id])
  type      RequestType @relation("TypeRequests", fields: [typeId], references: [id])
  assignees RequestAssignee[] @relation("RequestAssignments")
}

model ApprovalStep {
  id           String      @id @default(cuid())
  typeId       String
  order        Int
  requiredRole Role
  name         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  approvals    Approval[]
  type         RequestType @relation(fields: [typeId], references: [id])

  @@unique([typeId, order])
}

model Approval {
  id         String       @id @default(cuid())
  requestId  String
  stepId     String
  approverId String?
  approved   Boolean?
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime     @default(now())
  approver   User?        @relation("ApproverApprovals", fields: [approverId], references: [id])
  request    Request      @relation(fields: [requestId], references: [id])
  step       ApprovalStep @relation(fields: [stepId], references: [id])
}

model HistoryEntry {
  id        String   @id @default(cuid())
  requestId String
  step      String
  by        String
  role      Role?
  comment   String?
  date      DateTime @default(now())
  request   Request  @relation(fields: [requestId], references: [id])
}

model RequestAssignee {
  id        String  @id @default(cuid())
  requestId String
  userId    String
  stage     Role
  active    Boolean @default(true)
  request   Request @relation("RequestAssignments", fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RequestAssignee_request_fkey")
  user      User    @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RequestAssignee_user_fkey")

  @@index([active])
  @@index([requestId], map: "RequestAssignee_request_idx")
  @@index([userId], map: "RequestAssignee_user_idx")
  @@index([stage, active], map: "reqassign_stage_active")
  @@index([stage, userId, active], map: "reqassign_stage_user_active")
}

//
// NEW: counter table used to generate per-type, per-year sequences
// scope = `${TYPE}-${YY}` e.g., "IT-25", "HR-25"
//
model RequestCodeCounter {
  scope String @id
  last  Int    @default(0)
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  requestTypes RequestType[]
}

enum Role {
  EMPLOYEE
  MANAGER
  DIRECTOR
  ADMIN

  // New specialized roles
  HR_OFFICER
  IT_OFFICER
  FINANCE_OFFICER
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}
